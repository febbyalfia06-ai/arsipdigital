# MATIKAN SEMUA AKSES LANGSUNG DARI BROWSER (KEAMANAN TINGKAT TINGGI)
# File dokumen hanya bisa dibaca melalui proxy PHP (buka_file.php) setelah user login.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
